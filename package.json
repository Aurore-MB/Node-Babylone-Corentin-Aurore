{
  "name": "node-project",
  "version": "1.0.0",
  "description": "Node Project by Bab, Cor and Aur",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @node-project/api",
    "typecheck": "tsc --noEmit",
    "test": "npm run test -w @node-project/framework",
    "test:coverage": "npm run test:coverage -w @node-project/framework",
    "dev": "npm run dev -w @node-project/api",
    "start": "npm run start -w @node-project/api"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rolldown": "^1.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
